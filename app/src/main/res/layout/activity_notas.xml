<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CÁLCULO" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.15" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Média do aluno" android:textColor="@color/primary" android:textSize="27sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Digite as quatro notas para calcular a média final." android:textColor="@color/text_secondary" android:textSize="15sp" />
        <EditText android:id="@+id/etNota1" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" android:background="@drawable/input" android:hint="Nota da Prova 1" android:inputType="numberDecimal" />
        <EditText android:id="@+id/etNota2" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/input" android:hint="Nota da Prova 2" android:inputType="numberDecimal" />
        <EditText android:id="@+id/etTrabalho" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/input" android:hint="Nota do Trabalho" android:inputType="numberDecimal" />
        <EditText android:id="@+id/etAtividade" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/input" android:hint="Nota da Atividade" android:inputType="numberDecimal" />
        <Button android:id="@+id/btnCalcular" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:text="Calcular média" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="@color/primary" />
        <TextView android:id="@+id/tvResultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/result" android:gravity="center" android:padding="20dp" android:text="Média final: —" android:textColor="@color/success" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
